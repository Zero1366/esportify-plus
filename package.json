{
  "name": "esportify-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:back": "npm --prefix backend run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:back\"",
    "build": "tsc && vite build",
    "build:back": "npm --prefix backend run build",
    "build:full": "npm run build && npm run build:back",
    "git:save": "git add . && git commit -m \"chore: update project\" && git push",
    "deploy:full": "npm run build:full && npm run git:save",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "concurrently": "^10.0.3",
    "sass": "^1.99.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  }
}